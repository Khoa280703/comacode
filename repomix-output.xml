/// File watcher event data (for Dart)
#[derive(Debug, Clone)]
#[frb(sync)]
pub struct FileWatcherEventData {
    /// Event type: "file", "started", or "error"
    pub event_type: String,
    /// Watcher ID (for started/error events)
