  "apiEndpoints": [
    {
      "method": "GET",
      "path": "/api/v1/users",
      "description": "List all users with pagination and filtering",
      "authentication": "required",
      "roles": ["admin", "hr"],
      "rateLimit": 100,
      "parameters": {
        "query": {
          "page": { "type": "integer", "default": 1 },
          "limit": { "type": "integer", "default": 20, "max": 100 },
          "search": { "type": "string" },
          "role": { "type": "string", "enum": ["admin", "developer", "designer", "guest"] },
          "isActive": { "type": "boolean" }
        }
      },
      "responses": {
        "200": { "description": "Successful response with user list" },
        "401": { "description": "Unauthorized" },
        "403": { "description": "Forbidden - insufficient permissions" }
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/users",
      "description": "Create a new user",
      "authentication": "required",
      "roles": ["admin"],
      "rateLimit": 10,
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": {
          "name": { "type": "string", "required": true },
          "email": { "type": "string", "format": "email", "required": true },
          "role": { "type": "string", "required": true },
          "password": { "type": "string", "minLength": 8 }
        }
      },
      "responses": {
        "201": { "description": "User created successfully" },
        "400": { "description": "Invalid request body" },
        "409": { "description": "Email already exists" }
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/users/:id",
      "description": "Get user details by ID",
      "authentication": "required",
      "rateLimit": 100,
      "parameters": {
        "path": {
          "id": { "type": "string", "required": true }
        }
      }
    },
    {
      "method": "PUT",
      "path": "/api/v1/users/:id",
      "description": "Update user details",
      "authentication": "required",
      "roles": ["admin", "self"],
      "rateLimit": 50
    },
    {
      "method": "DELETE",
      "path": "/api/v1/users/:id",
      "description": "Delete a user",
      "authentication": "required",
      "roles": ["admin"],
      "rateLimit": 10
    },
    {
      "method": "GET",
      "path": "/api/v1/projects",
      "description": "List all projects",
      "authentication": "required",
      "rateLimit": 100,
      "parameters": {
        "query": {
          "status": { "type": "string", "enum": ["active", "archived", "deleted"] },
          "visibility": { "type": "string", "enum": ["public", "private"] }
        }
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/projects",
      "description": "Create a new project",
      "authentication": "required",
      "rateLimit": 20,
      "requestBody": {
        "required": true,
        "schema": {
          "name": { "type": "string", "required": true },
          "description": { "type": "string" },
          "visibility": { "type": "string", "default": "private" }
        }
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/projects/:id",
      "description": "Get project details",
      "authentication": "required",
      "rateLimit": 100
    },
    {
      "method": "POST",
      "path": "/api/v1/terminal/sessions",
      "description": "Create a new terminal session",
      "authentication": "required",
      "rateLimit": 30,
      "requestBody": {
        "schema": {
          "projectId": { "type": "string", "required": true },
          "shell": { "type": "string", "default": "bash" },
          "environment": { "type": "object" }
        }
      }
    },
    {
      "method": "DELETE",
      "path": "/api/v1/terminal/sessions/:id",
      "description": "Terminate a terminal session",
      "authentication": "required",
      "rateLimit": 50
    },
    {
      "method": "POST",
      "path": "/api/v1/auth/login",
      "description": "Authenticate user and get tokens",
      "authentication": "none",
      "rateLimit": 5,
      "requestBody": {
        "schema": {
          "email": { "type": "string", "format": "email", "required": true },
          "password": { "type": "string", "required": true }
        }
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/auth/refresh",
      "description": "Refresh access token",
      "authentication": "refresh_token",
      "rateLimit": 20
    },
    {
      "method": "POST",
      "path": "/api/v1/auth/logout",
      "description": "Logout and invalidate tokens",
      "authentication": "required",
      "rateLimit": 10
    },
    {
      "method": "GET",
      "path": "/api/v1/billing/subscription",
      "description": "Get current subscription details",
      "authentication": "required",
      "roles": ["admin", "finance"],
      "rateLimit": 50
    },
    {
      "method": "POST",
      "path": "/api/v1/billing/checkout",
      "description": "Create a checkout session",
      "authentication": "required",
      "rateLimit": 10
    },
    {
      "method": "GET",
      "path": "/api/v1/analytics/dashboard",
      "description": "Get dashboard analytics data",
      "authentication": "required",
      "roles": ["admin"],
      "rateLimit": 30,
      "parameters": {
        "query": {
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" },
          "granularity": { "type": "string", "enum": ["hour", "day", "week", "month"] }
        }
      }
    }
  ],
