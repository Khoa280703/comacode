{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "comacode-mobile",
  "version": "2.0.0",
  "description": "Mobile terminal and remote development platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/comacode/mobile"
  },
  "author": {
    "name": "Comacode Team",
    "email": "team@comacode.dev",
    "url": "https://comacode.dev"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "typescript": "^5.3.3",
    "lodash": "^4.17.21",
    "axios": "^1.6.2",
    "uuid": "^9.0.0",
    "zod": "^3.22.4",
    "date-fns": "^3.0.6",
    "@prisma/client": "^5.7.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.14.202",
    "vitest": "^1.1.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "nodemon": "^3.0.2"
  },
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc --build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,json}'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.cache",
    "prepare": "husky install",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "config": {
    "port": 3000,
    "host": "0.0.0.0",
    "debug": true,
    "logLevel": "info",
    "cors": {
      "enabled": true,
      "origins": [
        "http://localhost:3000",
        "https://comacode.dev",
        "https://app.comacode.dev",
        "https://staging.comacode.dev"
      ],
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "credentials": true,
      "maxAge": 86400
    },
    "rateLimit": {
      "windowMs": 900000,
      "max": 100,
      "message": "Too many requests from this IP, please try again later",
      "standardHeaders": true,
      "legacyHeaders": false
    },
    "session": {
      "secret": "${SESSION_SECRET}",
      "maxAge": 86400000,
      "secure": true,
      "httpOnly": true,
      "sameSite": "strict"
    },
    "database": {
      "url": "${DATABASE_URL}",
      "poolSize": 10,
      "connectionTimeout": 5000,
      "idleTimeout": 30000,
      "maxRetries": 3
    },
    "redis": {
      "url": "${REDIS_URL}",
      "maxRetries": 3,
      "retryDelay": 1000,
      "keyPrefix": "comacode:"
    }
  },
  "featureFlags": {
    "terminal": {
      "enabled": true,
      "maxSessions": 5,
      "idleTimeout": 600000,
      "historySize": 1000,
      "webSocketCompression": true,
      "allowCustomShell": false,
      "supportedShells": ["bash", "zsh", "fish", "sh"]
    },
    "fileViewer": {
      "enabled": true,
      "maxFileSize": 5242880,
      "supportedFormats": [
        "text/*",
        "image/*",
        "application/json",
        "application/xml",
        "application/javascript",
        "application/typescript"
      ],
      "syntaxHighlighting": true,
      "lineNumbers": true
    },
    "collaboration": {
      "enabled": false,
      "maxParticipants": 10,
      "voiceChat": false,
      "screenShare": true
    },
    "aiAssistant": {
      "enabled": true,
      "provider": "anthropic",
      "model": "claude-3-opus",
      "maxTokens": 4096,
      "temperature": 0.7,
      "features": {
        "codeCompletion": true,
        "codeExplanation": true,
        "bugDetection": true,
        "refactoring": true,
        "documentation": true
      }
    },
    "authentication": {
      "passwordless": true,
      "mfa": true,
      "sso": {
        "enabled": true,
        "providers": ["google", "github", "gitlab", "microsoft"]
      },
      "sessionDuration": 604800000
    },
    "billing": {
      "enabled": true,
      "stripeEnabled": true,
      "freeTier": {
        "maxProjects": 3,
        "maxStorage": 1073741824,
        "maxBuildMinutes": 300
      }
    },
    "analytics": {
      "enabled": true,
      "anonymizeIp": true,
      "sessionRecording": false
    },
    "notifications": {
      "email": true,
      "push": true,
      "inApp": true,
      "slack": true,
      "discord": false,
      "webhook": true
    },
    "experiments": {
      "newDashboard": {
        "enabled": false,
        "rolloutPercentage": 10,
        "targetGroups": ["beta_testers", "internal"]
      },
      "darkModeV2": {
        "enabled": true,
        "rolloutPercentage": 100
      },
      "performanceOptimizations": {
        "enabled": true,
        "lazyLoading": true,
        "virtualScrolling": true,
        "webWorkers": true
      }
    }
  },
